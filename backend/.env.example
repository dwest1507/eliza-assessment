# Copy to backend/.env (gitignored) and fill in your own values.
# The root Makefile reads this file with Make syntax, so do not quote values.

# The SEC requires every automated request to carry a User-Agent naming the
# requester and a contact email. Used by `make sec-facts` (and `make eda`).
SEC_USER_AGENT=Your Name you@example.com

# The OpenAI key, read by the OpenAI SDK. Used by the Answer Call (`make ask`, `make api`)
# when ANSWER_MODEL is an OpenAI model, as the default is.
OPENAI_API_KEY=your-openai-api-key

# The Anthropic key, read by the Anthropic SDK. Used by the Answer Call when ANSWER_MODEL
# is a Claude model, and by the generator comparison (`make eval-generators`, or
# `make eval-generation MODEL=claude-...`).
ANTHROPIC_API_KEY=your-anthropic-api-key

# The TypeSafe API key for Jev, the judge of the generation harness (`make eval-generation`).
JEV_API_KEY=your-jev-api-key

# Optional: the answer model, a model in the generator table
# (backend/src/edgar_answer/generators.py), OpenAI's or Anthropic's; set the key its
# provider needs above. Leave unset for the default, gpt-6-luna.
# ANSWER_MODEL=your-answer-model

# Optional: browser origins allowed to call the chat API directly (`make api`),
# comma-separated. Leave unset to allow none; the front-end reaches the API through its
# own server-side route, which needs no CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
